script = ExtResource("1_ukcvp")
question_info = "Qual é a principal ambiguidade (o \"paradoxo\") que Weber enxerga na racionalidade moderna?"
options = Array[String](["Ela gera riqueza extrema, mas elimina as leis jurídicas", "Ao buscar o máximo de eficiência, ela pode criar burocracias desumanas que limitam a própria liberdade do indivíduo", "Ela promove a ciência, mas aumenta a crença em magias populares", "Ela destrói o mercado financeiro através de regras antigas"])
correct = "Ao buscar o máximo de eficiência, ela pode criar burocracias desumanas que limitam a própria liberdade do indivíduo"
