script = ExtResource("1_kkyhr")
question_info = "A perspectiva sociológica de Weber diverge fortemente da de Émile Durkheim, principalmente porque Weber:"
options = Array[String](["Rejeita a ideia de que o social coaja o indivíduo de fora, partindo da ação individual para entender o todo", "Acredita que a sociedade é um organismo vivo independente dos indivíduos", "Foca exclusivamente na biologia evolutiva das populações", "Defende o uso da física para calcular comportamentos sociais"])
