[resource]
script = ExtResource("1_g83ds")
question_info = "Segundo a análise de Karl Marx sobre a política, o Estado nas sociedades de classe tem como função principal:"
options = Array[String](["Promover o bem-estar comum e a harmonia entre todos os cidadãos.", "Atuar como um instrumento de dominação e defesa dos interesses da classe dominante.", "Garantir que as tradições religiosas e culturais sejam preservadas acima da economia.", "Permanecer neutro e independente diante dos conflitos entre patrões e empregados."])
correct = "Atuar como um instrumento de dominação e defesa dos interesses da classe dominante."
