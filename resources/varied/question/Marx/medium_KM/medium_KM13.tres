[resource]
script = ExtResource("1_x8hac")
question_info = "Na teoria marxista, o comunismo representaria o estágio final da organização social. Entre suas características principais, destaca-se:"
options = Array[String](["O fortalecimento da propriedade privada dos meios de produção", "A abolição das classes sociais e a superação da exploração do trabalho.", "A centralização definitiva do poder nas mãos de um Estado burocrático.", "A manutenção das desigualdades materiais como forma de incentivar o esforço individual."])
correct = "A abolição das classes sociais e a superação da exploração do trabalho."
