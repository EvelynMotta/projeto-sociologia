script = ExtResource("1_fadhy")
question_info = "Para Marx, a principal força motriz que impulsiona a mudança social é:"
options = Array[String](["O consenso entre os grupos sociais em busca de estabilidade.", "O conflito de classes baseado na oposição de interesses materiais.", "O desenvolvimento natural das leis biológicas da espécie humana.", "O avanço ético e moral das civilizações ao longo do tempo."])
