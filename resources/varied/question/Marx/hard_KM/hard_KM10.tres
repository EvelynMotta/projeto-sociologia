script = ExtResource("1_thnka")
question_info = "Uma das consequências diretas do \"trabalho alienado\" é:"
options = Array[String](["O desenvolvimento da criatividade e do potencial artístico do operário.", "A desumanização do trabalhador, que passa a se sentir um estranho no que produz.", "O aumento da liberdade individual fora do ambiente de fábrica.", "A superação definitiva da necessidade de vender a força de trabalho."])
correct = "A desumanização do trabalhador, que passa a se sentir um estranho no que produz."
