[resource]
script = ExtResource("1_vaslj")
question_info = "Sobre o conceito de \"ideologia\", Marx afirma que a ideologia dominante em uma época é:"
options = Array[String](["Um conjunto neutro de valores que visa o bem comum de todos.", "Uma construção que reflete e justifica os interesses da classe que detém o poder.", "O resultado da vontade democrática da maioria da população.", "Um sistema científico baseado em verdades universais e imutáveis."])
correct = "Uma construção que reflete e justifica os interesses da classe que detém o poder."
