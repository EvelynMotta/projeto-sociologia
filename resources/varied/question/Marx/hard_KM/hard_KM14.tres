[resource]
script = ExtResource("1_kgoed")
question_info = "\"a história de todas as sociedades até hoje é a história da luta de classes\", significa que:"
options = Array[String](["O progresso histórico é fruto do antagonismo entre opressores e oprimidos.", "A paz social é o estado natural das civilizações humanas.", "A economia não tem influência sobre os eventos políticos mundiais.", "A história é um processo aleatório sem qualquer padrão identificável."])
correct = "O progresso histórico é fruto do antagonismo entre opressores e oprimidos."
