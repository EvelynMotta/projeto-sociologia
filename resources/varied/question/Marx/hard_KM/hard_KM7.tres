[resource]
script = ExtResource("1_6phfp")
question_info = "A \"revolução proletária\" é descrita na teoria marxista como o momento em que:"
options = Array[String](["O proletariado toma o poder para abolir a propriedade privada e a exploração.", "A classe trabalhadora negocia melhores condições dentro do capitalismo.", "O governo decide distribuir renda através de reformas assistencialistas.", "As máquinas passam a ser propriedade exclusiva de intelectuais e técnicos."])
correct = "O proletariado toma o poder para abolir a propriedade privada e a exploração."
